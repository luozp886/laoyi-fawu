# 应用配置
APP_NAME=劳翼AI法务
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

# 日志配置
LOGGING_LEVEL=INFO

# 数据库配置（指向你运行 postgres 的主机/VM）
DB_HOST=192.168.150.101
DB_PORT=5432
DB_NAME=legal_consult
DB_USER=legal
DB_PASSWORD=change_me
DB_ECHO=false

# 模型配置（DeepSeek）
DEEPSEEK_API_KEY=change_me
CHAT_MODEL=deepseek-chat

# DashScope（Embedding + 重排 + 图像）
DASHSCOPE_API_KEY=change_me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 本项目法规为 markdown 直接入库，已不使用 MinerU 解析 PDF，此键可留空
MINERU_TOKEN=

# milvus
MILVUS_HOST=192.168.150.101
MILVUS_PORT=19530

# JWT 双 token 配置（登录鉴权）
# 访问令牌有效期（分钟）：短时有效，过期后前端用刷新令牌自动续期
JWT_ACCESS_EXPIRE_MINUTES=120
# 刷新令牌有效期（天）：长效令牌，用于换取新的访问令牌
JWT_REFRESH_EXPIRE_DAYS=7
# JWT 签名密钥（生产环境务必修改）
JWT_SECRET=change_me
